OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_TOKENS=8192
OPENAI_ENABLE_THINKING=false
OPENAI_THINKING_BUDGET=4096
# JSON-constrained interpretation/supervision; disable for models that reason
# until finish_reason=length without emitting their final answer.
OPENAI_STRUCTURED_ENABLE_THINKING=false
# Reasoning can remain enabled for interpretation while artifact output stays direct.
OPENAI_CODE_ENABLE_THINKING=false
OPENAI_CODE_MAX_TOKENS=8192
CAD_AGENT_MAX_ATTEMPTS=3
CAD_AGENT_ACCEPT_SCORE=70
OPENSCAD_BIN=openscad
DOODLE_HOST=127.0.0.1
DOODLE_PORT=8080
DOODLE_RESULTS_DIR=results
