{
  "version": 1,
  "units": "mm",
  "name": "Rounded open tray",
  "parameters": {
    "thickness": {
      "value": 3.0,
      "min": 1,
      "max": 10,
      "unit": "mm"
    }
  },
  "operations": [
    {
      "id": "body",
      "kind": "box",
      "origin": [
        0,
        0,
        0
      ],
      "size": [
        80,
        60,
        30
      ]
    },
    {
      "id": "rounded",
      "kind": "fillet",
      "body": "body",
      "radius": 8,
      "selector": "outer_vertical"
    },
    {
      "id": "tray",
      "kind": "shell",
      "body": "rounded",
      "thickness": "thickness",
      "opening": "top",
      "preserve": "outer"
    }
  ],
  "output": "tray"
}
