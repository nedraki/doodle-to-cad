{
  "version": 1,
  "units": "mm",
  "name": "bench curved handle (arc_pipe + cylinder legs)",
  "parameters": {
    "bend_radius": {"value": 20, "min": 5, "max": 100, "label": "Bend Centreline Radius", "unit": "mm", "group": "Body"},
    "leg_length": {"value": 30, "min": 5, "max": 100, "label": "Straight Leg Length", "unit": "mm", "group": "Body"},
    "section_diameter": {"value": 8, "min": 1, "max": 50, "label": "Handle Diameter", "unit": "mm", "group": "Body"}
  },
  "operations": [
    {"id": "handle", "kind": "arc_pipe", "origin": [0, 0, "section_diameter/2"], "bend_radius": "bend_radius", "radius": "section_diameter/2", "angle": 180},
    {"id": "leg_left", "kind": "cylinder", "origin": ["-bend_radius", 0, 0], "radius": "section_diameter/2", "height": "leg_length", "axis": "z"},
    {"id": "leg_right", "kind": "cylinder", "origin": ["bend_radius", 0, 0], "radius": "section_diameter/2", "height": "leg_length", "axis": "z"},
    {"id": "left_join", "kind": "union", "left": "handle", "right": "leg_left"},
    {"id": "handle_assembly", "kind": "union", "left": "left_join", "right": "leg_right"}
  ],
  "output": "handle_assembly"
}
